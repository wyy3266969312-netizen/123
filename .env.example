# --- Accounts (optional; without these the app sells license keys only) -----
# From Supabase: Project Settings -> API Keys.
# The publishable key is public by design — the database is protected by
# row-level security, not by hiding it. The secret key bypasses RLS entirely
# and must never carry a VITE_ prefix, or the bundler would ship it.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Paywall (required in production) ---------------------------------------
# Signs and verifies license keys. Generate once with `openssl rand -base64 48`
# and never change it afterwards: rotating this secret invalidates every key
# already sold.
LICENSE_SIGNING_SECRET=your_long_random_secret_here

# Authenticates POST /api/issue-license, the endpoint that mints new keys after
# a buyer pays. Keep it separate from the signing secret.
LICENSE_ADMIN_TOKEN=your_admin_token_here

# Optional. Serials of keys that should stop working — refunds, or a key that
# got shared publicly. Comma or whitespace separated, 8 characters each; the
# serial is the part of the key right after the SOP- prefix.
LICENSE_REVOKED_SERIALS=

# --- Purchase page (build-time, so these are public) ------------------------
# Shown on the paywall. All optional; each has a sensible default.
VITE_LICENSE_PRICE_LABEL=¥49
VITE_LICENSE_CONTACT=your_wechat_id
# Path or URL of your payment QR image. Put the file in `public/` and point
# here, e.g. /pay-qr.png. Leave empty to hide the QR block.
VITE_LICENSE_PAY_QR=
# A hosted checkout page, if you have one. Leave empty to hide the button.
VITE_LICENSE_BUY_URL=

# --- Optional DeepSeek API configuration ------------------------------------
# Used for creator reply translation and personalized replies.
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-chat

